/**
 * @brief フルキー
 */
struct tagFullKey
{
	UINT8 cLeftWidth;
	UINT8 cLeftCode;
	UINT8 cKeyCount;
	UINT8 cKeyCode;
	UINT8 cRightCode1;
	UINT8 cRightCode2;
};

/**
 * @brief キー テーブル
 */
struct tagKeyTable
{
	struct tagFullKey fullKey[4];
	UINT8 tenKey[6][4];
};

/**
 * キー設定
 */
static const struct tagKeyTable s_keytbl =
{
	/* フルキー 4行 */
	{
		{12,0x00, 13,0x01, 0x0e,0x0e},
		{19,0x0f, 12,0x10, 0x38,0x1c},
		{21,0xf1, 12,0x1d, 0x1c,0x1c},
		{25,0x70, 11,0x29, 0x70,0x70}
	},

	/* テンキー */
	{
		{0x3e, 0x41, 0x45, 0x40},	/* H / * - */
		{0x42, 0x43, 0x44, 0x49},	/* 7 8 9 + */
		{0x46, 0x47, 0x48, 0x4d},	/* 4 5 6 = */
		{0x4a, 0x4b, 0x4c, 0x50},	/* 1 2 3 . */
		{0x4e, 0x4f, 0x3a, 0x1c},	/* 0 , ^ C */
		{0x3b, 0x3c, 0x3d, 0x1c},	/* < > v R */
	}
};

/**
 * 位置からキーコードを得る
 * @param[in] x X座標
 * @param[in] y Y座標
 * @return キーコード
 */
static UINT getsoftkbd(int x, int y)
{
	const struct tagFullKey* fk;

	if ((x < 40) || (y < 4) || (y >= (4 + 72)))
	{
	}
	else if (x < (40 + 192))
	{
		if (y < (4 + 9))
		{
			/* ファンクション */
			if (x < (40 + 90))
			{
				/* F1 ～ F5 */
				return 0x62 + ((x - 40) / 18);
			}
			else if (x < (40 + 93))
			{
			}
			else if (x < (40 + 109))
			{
				/* ROLL UP*/
				return 0x36;
			}
			else if (x < (40 + 124))
			{
				/* ROLL DOWN*/
				return 0x37;
			}
			else if (x < (40 + 126))
			{
			}
			else if (x < (40 + 141))
			{
				/* HELP */
				return 0x3f;
			}
			else if (x < (40 + 156))
			{
				/* COPY */
				return 0x60;
			}
		}
		else if (y < (4 + 9))
		{
		}
		else if (y < (4 + 60))
		{
			if (x < (40 + 186))
			{
				/* フルキー */
				fk = &s_keytbl.fullKey[(y - (4 + 12)) / 12];
				x -= 40;
				x -= fk->cLeftWidth;
				if (x < 0)
				{
					return fk->cLeftCode;
				}
				x /= 12;
				if (x < fk->cKeyCount)
				{
					return fk->cKeyCode + x;
				}
				x -= fk->cKeyCount;
				return (x == 0) ? fk->cRightCode1 : fk->cRightCode2;
			}
		}
		else
		{
			if (x < (40 + 25))
			{
			}
			else if (x < (40 + 37))
			{
				/* GRAPH */
				return 0x73;
			}
			else if (x < (40 + 49))
			{
				/* CAPS */
				return 0x81;
			}
			else if (x < (40 + 139))
			{
				/* スペース */
				return 0x34;
			}
			else if (x < (40 + 151))
			{
				/* カナ */
				return 0x82;
			}
			else if (x < (40 + 163))
			{
				/* XFER */
				return 0x35;
			}
		}
	}
	else if (x < (40 + 240))
	{
		{
			/* テンキー */
			return s_keytbl.tenKey[(y - 4) / 12][(x - (40 + 192)) / 12];
		}
	}
	return SOFTKEY_NC;
}
